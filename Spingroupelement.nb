        RowBox[{
         RowBox[{
          FractionBox["n", "2"], "//", "Floor"}], ",", "i"}], "]"}]}], "/;", 
      RowBox[{"0", "\[LessEqual]", "i", "\[LessEqual]", " ", "n"}]}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MatrixRepresentation", "::", "usage"}], "=", 
   "\"\<MatrixRepresentation[expr] converts the Clifford expression expr to \
its matrix representation, replacing products of basis vectors by matrix Dot \
products. Generator e[j] maps to CliffordMatrix[j - $FirstIndex + 1].\>\""}], 
  ";"}], "\[IndentingNewLine]", 
