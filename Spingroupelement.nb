Cell[CellGroupData[{

Cell["SO(2,2) example", "Subsubsection",
 CellChangeTimes->{{3.9992946534125032`*^9, 3.9992946543205237`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"P4", "=", 
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {
       FractionBox["5", "3"], "0", 
       FractionBox["4", "3"], "0"},
      {"0", "1", "0", "0"},
      {
       FractionBox["4", "3"], "0", 
       FractionBox["5", "3"], "0"},
      {"0", "0", "0", "1"}
     }], "\[NoBreak]", ")"}]}], ";"}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"$SetSignature", "=", 
     RowBox[{"{", 
      RowBox[{"2", ",", "2"}], "}"}]}], "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Signature", " ", "matrix"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eta", "=", 
     RowBox[{
      RowBox[{"Apply", "[", 
       RowBox[{"Join", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"-", "1"}]}], "}"}], "*", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ConstantArray", "[", 
             RowBox[{"1", ",", "#"}], "]"}], "&"}], ",", "$SetSignature"}], 
          "]"}]}]}], "]"}], "//", "DiagonalMatrix"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Check", " ", "conditions"}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Transpose", "[", "P4", "]"}], ".", "eta", ".", "P4"}], "==",
         "eta"}], ",", 
       RowBox[{
        RowBox[{"Det", "[", "P4", "]"}], "\[Equal]", "1"}]}], "}"}], "//", 
     "Print"}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Element", " ", "of", " ", "the", " ", "spin", " ", "group"}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{"spinelement", "=", 
     RowBox[{
      RowBox[{"P4", "//", "FirstSpinCandidate"}], "//", "SpinSimplify"}]}], 
    ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Element", " ", "of", " ", "the", " ", "spin", " ", "group"}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{"spinmatrix", "=", 
     RowBox[{
      RowBox[{"spinelement", "//", "Last"}], "//", "MatrixRepresentation"}]}],
     ";", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Check", " ", "matrix", " ", "representation"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"spinmatrix", ".", 
          RowBox[{"CliffordMatrix", "[", "a$", "]"}], ".", 
          RowBox[{"Inverse", "[", "spinmatrix", "]"}]}], "==", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"CliffordMatrix", "[", "b$", "]"}], 
            RowBox[{"P4", "[", 
             RowBox[{"[", 
              RowBox[{"b$", ",", "a$"}], "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"b$", ",", 
             RowBox[{"Plus", "@@", "$SetSignature"}]}], "}"}]}], "]"}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"a$", ",", 
         RowBox[{"Plus", "@@", "$SetSignature"}]}], "}"}]}], "]"}], "//", 
     "Print"}]}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.9992883002760315`*^9, 3.9992883035882854`*^9}, {
