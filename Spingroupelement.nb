Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SpinCandidates", "::", "usage"}], "=", 
   "\"\<SpinCandidates[P] returns rules f -> s for the even Clifford basis \
elements f whose M_f has nonzero magnitude. Each s is the normalized \
representative M_f/Magnitude[M_f]. The two spin-group elements covering P are \
s and -s. The calculation uses $SetSignature and $FirstIndex.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SpinCandidates", "::", "wrongdimensions"}], "=", 
   "\"\<Dimensions of the matrix `1` do not match $SetSignature \
values.\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SpinCandidates", "[", 
    RowBox[{"P_", "?", "MatrixQ"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dim", "=", 
        RowBox[{"Dimensions", "[", "P", "]"}]}], ",", 
       RowBox[{"SubsetToMultivector", "=", 
        RowBox[{
         RowBox[{"Times", "@@", 
          RowBox[{"Map", "[", 
           RowBox[{"e", ",", 
            RowBox[{"#", "+", "$FirstIndex", "-", "1"}]}], "]"}]}], "&"}]}]}],
       "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"SameQ", "@@", 
          RowBox[{"Append", "[", 
           RowBox[{"dim", ",", 
            RowBox[{"Plus", "@@", "$SetSignature"}]}], "]"}]}]}], ",", 
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"SpinCandidates", "::", "wrongdimensions"}], ",", 
          RowBox[{"ToString", "[", 
           RowBox[{"dim", ",", "InputForm"}], "]"}]}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"fset", "=", 
          RowBox[{"SubsetToMultivector", "/@", 
           RowBox[{"Select", "[", " ", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"dim", "//", "Min"}], "//", "Range"}], "//", 
              "Subsets"}], ",", 
             RowBox[{
              RowBox[{"EvenQ", "[", 
               RowBox[{"Length", "[", "#", "]"}], "]"}], "&"}]}], "]"}]}]}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"MF", "[", 
             RowBox[{"P", ",", "f$"}], "]"}], "//", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"f$", ",", "#", ",", 
               RowBox[{"#", "//", "Magnitude"}]}], "}"}], "&"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"f$", ",", "fset"}], "}"}]}], "]"}], "//", 
         RowBox[{
          RowBox[{"Cases", "[", 
           RowBox[{"#", ",", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"f_", ",", "MF_", ",", 
               RowBox[{"den_", "/;", 
                RowBox[{"!", 
                 RowBox[{"PossibleZeroQ", "[", "den", "]"}]}]}]}], "}"}], 
             "\[RuleDelayed]", 
             RowBox[{"Rule", "[", 
              RowBox[{"f", ",", 
               RowBox[{
                FractionBox["1", "den"], "MF"}]}], "]"}]}]}], "]"}], 
          "&"}]}]}], "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.98986287007082*^9, 3.9898628788518176`*^9}, {
   3.9898629446742573`*^9, 3.9898630195290337`*^9}, {3.989863344222116*^9, 
   3.9898633557998505`*^9}, {3.9898635329354763`*^9, 
   3.9898635395603013`*^9}, {3.9898635935272746`*^9, 
   3.9898636309479756`*^9}, {3.9898637735524855`*^9, 3.989863790411338*^9}, {
   3.989863904861261*^9, 3.9898639125793333`*^9}, {3.9898639427503867`*^9, 
   3.9898639981078744`*^9}, {3.9898640546060796`*^9, 
   3.9898640686842785`*^9}, {3.9898641292128763`*^9, 
   3.9898642563860383`*^9}, {3.98986429920855*^9, 3.989864308036433*^9}, {
   3.9898645216099634`*^9, 3.98986453146902*^9}, {3.989864769167384*^9, 
   3.9898647749880886`*^9}, {3.9898648818881464`*^9, 
   3.9898648834520693`*^9}, {3.989864950716308*^9, 3.98986503761779*^9}, {
   3.9898650721846533`*^9, 3.9898651892478037`*^9}, {3.989865617649932*^9, 
   3.9898656219168205`*^9}, 3.989872238373841*^9, {3.9992833457164803`*^9, 
   3.9992833473579473`*^9}, {3.999285267025584*^9, 3.9992852892088785`*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"FirstSpinCandidate", "::", "usage"}], "=", 
   "\"\<FirstSpinCandidate[P] returns the first rule f -> s that \
SpinCandidates[P] would produce, stopping when an even Clifford basis element \
f with nonzero M_f magnitude is found.\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FirstSpinCandidate", "::", "wrongdimensions"}], "=", 
   RowBox[{"SpinCandidates", "::", "wrongdimensions"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FirstSpinCandidate", "::", "nocandidates"}], "=", 
   "\"\<No spin-group element found: P is not a valid matrix,\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FirstSpinCandidate", "[", 
    RowBox[{"P_", "?", "MatrixQ"}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dim", "=", 
        RowBox[{"Dimensions", "[", "P", "]"}]}], ",", 
       RowBox[{"SubsetToMultivector", "=", 
        RowBox[{
         RowBox[{"Times", "@@", 
          RowBox[{"Map", "[", 
           RowBox[{"e", ",", 
            RowBox[{"#", "+", "$FirstIndex", "-", "1"}]}], "]"}]}], "&"}]}]}],
       "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"SameQ", "@@", 
          RowBox[{"Append", "[", 
           RowBox[{"dim", ",", 
            RowBox[{"Plus", "@@", "$SetSignature"}]}], "]"}]}]}], ",", 
        RowBox[{"Message", "[", 
         RowBox[{
          RowBox[{"FirstSpinCandidate", "::", "wrongdimensions"}], ",", 
          RowBox[{"ToString", "[", 
           RowBox[{"dim", ",", "InputForm"}], "]"}]}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Catch", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"f$", "=", 
                 RowBox[{"SubsetToMultivector", "[", "indices$", "]"}]}], 
                "}"}], ",", 
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"MF$", "=", 
                   RowBox[{"MF", "[", 
                    RowBox[{"P", ",", "f$"}], "]"}]}], "}"}], ",", 
                 RowBox[{"With", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"den$", "=", 
                    RowBox[{"Magnitude", "[", "MF$", "]"}]}], "}"}], ",", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"!", 
                    RowBox[{"PossibleZeroQ", "[", "den$", "]"}]}], ",", 
                    RowBox[{"Throw", "[", 
                    RowBox[{
                    RowBox[{"Rule", "[", 
                    RowBox[{"f$", ",", 
                    RowBox[{"MF$", "/", "den$"}]}], "]"}], ",", 
                    "FirstSpinCandidate"}], "]"}]}], "]"}]}], "]"}]}], 
                "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"indices$", ",", 
               RowBox[{"Subsets", "[", 
                RowBox[{
                 RowBox[{"Range", "[", 
                  RowBox[{"Min", "[", "dim", "]"}], "]"}], ",", 
                 RowBox[{"{", "g$", "}"}]}], "]"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"g$", ",", "0", ",", 
             RowBox[{"Min", "[", "dim", "]"}], ",", "2"}], "}"}]}], "]"}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"Message", "[", 
          RowBox[{"FirstSpinCandidate", "::", "nocandidates"}], "]"}]}], ",", 
        "FirstSpinCandidate"}], "]"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9992863197306623`*^9, 3.9992863395995007`*^9}, {
  3.9992863896685286`*^9, 3.9992864669090137`*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"EuclideanCliffordMatrix", "::", "usage"}], "=", 
   "\"\<EuclideanCliffordMatrix[m, i] constructs the Euclidean Clifford \
matrix used for generator i from m Kronecker factors; i = 0 denotes the \
identity matrix.\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EuclideanCliffordMatrix", "[", 
    RowBox[{
     RowBox[{"m_Integer", "/;", 
      RowBox[{"0", "\[LessEqual]", "m", "\[LessEqual]", "1"}]}], ",", 
     "i_Integer"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"PauliMatrix", "[", "i", "]"}], "/;", 
    RowBox[{"0", "\[LessEqual]", "i", "\[LessEqual]", 
     RowBox[{
      RowBox[{"2", "m"}], "+", "1"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EuclideanCliffordMatrix", "[", 
    RowBox[{
     RowBox[{"m_Integer", "/;", 
      RowBox[{"m", ">", "0"}]}], ",", "0"}], "]"}], ":=", 
   RowBox[{"IdentityMatrix", "[", 
    RowBox[{"2", "^", "m"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EuclideanCliffordMatrix", "[", 
    RowBox[{"m_Integer", ",", 
     RowBox[{"i_Integer", "?", "OddQ"}]}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"i", "+", "1"}], ")"}], "/", "2"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"KroneckerProduct", "@@", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"PauliMatrix", "[", "3", "]"}], ",", 
           RowBox[{"k", "-", "1"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"PauliMatrix", "[", "1", "]"}], "}"}], ",", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"PauliMatrix", "[", "0", "]"}], ",", 
           RowBox[{"m", "-", "k"}]}], "]"}]}], "]"}]}], "/;", 
      RowBox[{"m", "\[GreaterEqual]", "k", ">", "0"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EuclideanCliffordMatrix", "[", 
    RowBox[{"m_Integer", ",", 
     RowBox[{"i_Integer", "?", "EvenQ"}]}], "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", "=", 
       RowBox[{"i", "/", "2"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"KroneckerProduct", "@@", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"PauliMatrix", "[", "3", "]"}], ",", 
           RowBox[{"k", "-", "1"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"PauliMatrix", "[", "2", "]"}], "}"}], ",", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"PauliMatrix", "[", "0", "]"}], ",", 
           RowBox[{"m", "-", "k"}]}], "]"}]}], "]"}]}], "/;", 
      RowBox[{"m", "\[GreaterEqual]", "k", ">", "0"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EuclideanCliffordMatrix", "[", 
    RowBox[{"m_Integer", ",", "i_Integer"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"KroneckerProduct", "@@", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"PauliMatrix", "[", "3", "]"}], ",", "m"}], "]"}]}], "/;", 
    RowBox[{"i", "==", 
     RowBox[{
      RowBox[{"2", "m"}], "+", "1"}], ">", "0"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"CliffordMatrix", "::", "usage"}], "=", 
   "\"\<CliffordMatrix[i] returns the matrix representation of Clifford \
generator at position i for $SetSignature, independently of $FirstIndex. \
Positions run from 1 to the dimension; CliffordMatrix[0] returns the identity \
matrix.\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"CliffordMatrix", "[", "i_Integer", "]"}], ":=", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", "=", 
       RowBox[{"Plus", "@@", "$SetSignature"}]}], "}"}], ",", 
     RowBox[{
