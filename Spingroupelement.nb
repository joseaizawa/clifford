   3.9898440297150545`*^9}, {3.9898441242900896`*^9, 3.989844168194948*^9}, {
   3.989844344626943*^9, 3.9898443524865017`*^9}, {3.989844397500678*^9, 
   3.9898444392801113`*^9}, {3.989844496575267*^9, 3.9898445077158937`*^9}, {
