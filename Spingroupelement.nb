Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SpinSimplify", "::", "usage"}], "=", 
   "\"\<SpinSimplify[expr] simplifies scalar coefficients in expr and \
collects terms with respect to the Clifford basis vectors e[i].\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SpinSimplify", "=", 
   RowBox[{
    RowBox[{"Expand", "[", 
     RowBox[{
      RowBox[{"Collect", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "/.", 
          RowBox[{
           RowBox[{"_", "?", "PossibleZeroQ"}], "\[Rule]", "0"}]}], "//", 
         "Simplify"}], ",", "_e"}], "]"}], ",", "_e"}], "]"}], "&"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.999282979972792*^9, 3.999283022493487*^9}, {
  3.9992834239736166`*^9, 3.999283502994008*^9}, {3.999290036078929*^9, 
  3.999290040898692*^9}, {3.9992904825877028`*^9, 3.999290493656167*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MF", "::", "usage"}], "=", 
   "\"\<MF[P, f] calculates the multivector M_f of equation (14) of \
arXiv:2412.02772 for the matrix P and the even Clifford basis element f. The \
calculation uses $SetSignature and $FirstIndex.\>\""}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MF", "[", 
    RowBox[{
     RowBox[{"P_", "?", "MatrixQ"}], ",", " ", "f_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r$", " ", "=", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"P", "//", "Dimensions"}], "//", "Min"}], "//", "Range"}]}],
        ",", 
       RowBox[{"SubsetToMultivector", "=", 
        RowBox[{
         RowBox[{"Times", "@@", 
          RowBox[{"Map", "[", 
           RowBox[{"e", ",", 
            RowBox[{"#", "+", "$FirstIndex", "-", "1"}]}], "]"}]}], "&"}]}]}],
       "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"f", "+", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"subs", " ", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"#", ",", 
                RowBox[{"#", "//", "SubsetToMultivector"}]}], "}"}], "&"}], "/@",
              " ", 
             RowBox[{"Subsets", "[", 
              RowBox[{"r$", ",", " ", 
               RowBox[{"{", "g$", "}"}]}], "]"}]}]}], "}"}], ",", 
          "\[IndentingNewLine]", " ", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Sum", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Det", "[", 
                 RowBox[{"P", "[", 
                  RowBox[{"[", " ", 
                   RowBox[{
                    RowBox[{"B$", "//", "First"}], ",", " ", 
                    RowBox[{"A$", "//", "First"}]}], "]"}], "]"}], "]"}], "*", 
                RowBox[{"GeometricProduct", "[", 
                 RowBox[{
                  RowBox[{"B$", "//", "Last"}], ",", " ", "f", ",", 
                  RowBox[{"A$", "//", "Last"}]}], " ", "]"}]}], ",", 
               "\[IndentingNewLine]", " ", 
               RowBox[{"{", 
                RowBox[{"B$", ",", " ", "subs"}], "}"}]}], "]"}], "/", 
             RowBox[{"GeometricProduct", "[", 
              RowBox[{
               RowBox[{"A$", "//", "Last"}], ",", 
               RowBox[{"A$", "//", "Last"}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"A$", ",", " ", "subs"}], "}"}]}], "]"}]}], 
         "\[IndentingNewLine]", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"g$", ",", "r$"}], "}"}]}], "]"}]}]}], "\[IndentingNewLine]",
     "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9898426285662184`*^9, 3.989842650393385*^9}, {
   3.9898427040234776`*^9, 3.9898427941144457`*^9}, {3.989843263602133*^9, 
   3.989843307538685*^9}, {3.989843579373294*^9, 3.9898435827795677`*^9}, 
   3.989843836548681*^9, {3.9898439154992933`*^9, 3.989843919405818*^9}, {
